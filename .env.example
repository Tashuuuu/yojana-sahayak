# Copy this file to .env and enter your own keys. NEVER commit .env.
GNANI_STT_API_KEY=your_gnani_api_key
GNANI_TTS_API_KEY=your_gnani_api_key
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
PRISMA_STT_MODEL=prisma-v3.0
PRISMA_LANGUAGE_CODE=indic-auto
PRISMA_LANGUAGE_CANDIDATES=hi-IN,en-IN
PRISMA_V25_FALLBACK=1
# Prisma v2.5 fallback is single-language; change to en-IN for English-only fallback use.
PRISMA_V25_LANGUAGE_CODE=hi-IN

# Primary project choice: open-weight Llama via Groq.
GROQ_API_KEY=your_groq_api_key
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Groq's current Developer/free model list has retired Llama 3.3 70B for those plans.
# If your Groq account cannot access the selected Llama model, choose ONE permitted fallback:
# A) Ollama Llama 3.1 8B (requires Ollama installed and sufficient laptop RAM):
#    ollama pull llama3.1:8b
#    LLM_PROVIDER=ollama
#    OLLAMA_BASE_URL=http://localhost:11434/v1
#    OLLAMA_MODEL=llama3.1:8b
# B) Gemini via Google AI Studio (not open-weight; disclose this fallback in your submission):
#    LLM_PROVIDER=gemini
#    GEMINI_API_KEY=your_google_ai_studio_key
#    GEMINI_MODEL=gemini-3.8-flash
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-3.8-flash

# Runtime and verifier configuration
DRY_RUN=0
MIN_SIMILARITY=0.30
T_ENT=0.60
T_CON=0.50
